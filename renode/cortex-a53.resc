:name: Cortex-A53
:description: This script runs a minimal code.

$bin?=@build_aarch64/firmware.elf
$name?="ARM Cortex-A53"

using sysbus
mach create $name

machine LoadPlatformDescription @renode/cortex-a53-gicv3.repl

showAnalyzer uart0

macro reset
"""
    sysbus LoadELF $bin
"""
runMacro $reset

machine StartGdbServer 3333
logLevel -1 sysbus.gic
